// TestProjection runs the slice's specifications: the given events through
// the projection, then the rows the query returns.
func TestProjection(t *testing.T) {
	tests := []struct {
		name  string
		given []eventsourcing.Event
		want  []Row
		skip  string
	}{
{{- range .Specs}}
		{
			name: {{quote (printf "spec: %s - %s" $.Slice.Title .Title)}},
{{- range .Notes}}
