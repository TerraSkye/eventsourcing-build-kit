{{- end}}
{{- if .Given}}
			given: []eventsourcing.Event{
{{- range .Given}}
				&events.{{.Event.GoName}}{ {{- template "fields" .Fields}} },
{{- end}}
			},
{{- end}}
{{- if .Want}}
			want: []Row{
{{- range .Want}}
				{ {{- template "fields" .}} },
{{- end}}
			},
{{- end}}
{{- if .Skip}}
			skip: {{quote .Skip}},
{{- end}}
		},
{{- end}}
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			if tt.skip != "" {
				t.Skip("TODO: " + tt.skip)
			}
			m := New{{.GoName}}()
			p := NewProjection(m)
			for _, e := range tt.given {
				if err := p.Handler.Handle(t.Context(), e); err != nil {
					t.Fatalf("handle %s: %v", e.EventType(), err)
				}
			}

			got, err := NewQueryHandler(m).HandleQuery(t.Context(), Query{})
			if err != nil {
				t.Fatalf("query: %v", err)
			}
			if len(got) == 0 && len(tt.want) == 0 {
				return
			}
			slices.SortFunc(tt.want, compareRows)
			gotJSON, _ := json.Marshal(got)
			wantJSON, _ := json.Marshal(tt.want)
			if !bytes.Equal(gotJSON, wantJSON) {
				t.Errorf("rows = %s, want %s", gotJSON, wantJSON)
			}
		})
	}
}
