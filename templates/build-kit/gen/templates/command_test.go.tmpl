// Test_decide runs the slice's specifications: the given events replayed
// through evolve, then decide with the command.
func Test_decide(t *testing.T) {
	tests := []struct {
		name    string
		history []eventsourcing.Event
		cmd     {{.GoName}}
		want    []eventsourcing.Event
		wantErr error
		skip    string
	}{
{{- range .Specs}}
		{
			name: {{quote (printf "spec: %s - %s" $.Slice.Title .Title)}},
{{- range .Notes}}
			// Note: {{.}}.
{{- end}}
{{- if .Given}}
			history: []eventsourcing.Event{
{{- range .Given}}
				&events.{{.Event.GoName}}{ {{- template "fields" .Fields}} },
{{- end}}
			},
{{- end}}
			cmd: {{$.Cmd.GoName}}{ {{- template "fields" .When}} },
{{- if .WantErr}}
			wantErr: {{.WantErr}},
{{- else if .Want}}
			want: []eventsourcing.Event{
{{- range .Want}}
				&events.{{.Event.GoName}}{ {{- template "fields" .Fields}} },
{{- end}}
			},
{{- end}}
{{- if .Skip}}
			skip: {{quote .Skip}},
{{- end}}
		},
{{- end}}
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			if tt.skip != "" {
				t.Skip("TODO: " + tt.skip)
			}
			s := initialState()
			for _, e := range tt.history {
				s = evolve(s, &eventsourcing.Envelope{Event: e})
			}

			got, err := decide(s, tt.cmd)
			if !errors.Is(err, tt.wantErr) {
				t.Fatalf("decide() error = %v, want %v", err, tt.wantErr)
			}
			gotJSON, _ := json.Marshal(withoutGenerated(got))
			wantJSON, _ := json.Marshal(tt.want)
			if !bytes.Equal(gotJSON, wantJSON) {
				t.Errorf("decide() = %s, want %s", gotJSON, wantJSON)
			}
		})
	}
}

