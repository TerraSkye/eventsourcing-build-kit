	var got []{{.Command.Slice.Package}}.{{.Command.GoName}}
	handler := func(_ context.Context, cmd {{.Command.Slice.Package}}.{{.Command.GoName}}) (eventsourcing.AppendResult, error) {
		got = append(got, cmd)
		return eventsourcing.AppendResult{}, nil
	}
	def := NewAutomation({{.Todo.Slice.Package}}.New{{.Todo.GoName}}(), nil, handler)
	if err := def.Work(t.Context(), item); err != nil {
		t.Fatalf("Work: %v", err)
